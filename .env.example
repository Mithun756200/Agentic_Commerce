# ─────────────────────────────────────────────────────────────
# AI Buyer Agent — Environment Variables
# Copy this file to .env.local and fill in your real keys.
# ─────────────────────────────────────────────────────────────

# Google Gemini API Key
# Get it at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# Razorpay TEST-MODE credentials
# Get them at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# Safety Limits (optional — these are the defaults)
MAX_BUDGET_INR=5000
ALLOWED_CATEGORIES=electronics,accessories,peripherals
MAX_QUANTITY=3
